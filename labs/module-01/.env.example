# ---------------------------------------------------------------------------
# Module 01 — Engineering Task Board
#
# Copy this file to .env and fill in the real values. .env is git-ignored;
# making the copy yourself is part of the lab.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- .NET backend (backend-dotnet) -----------------------------------------
# ASP.NET Core reads this as ConnectionStrings:DefaultConnection.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=taskboard;Username=postgres;Password=CHANGE_ME

# --- Python backend (backend-python) --------------------------------------
# SQLAlchemy async URL (note the +asyncpg driver).
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/taskboard

# --- Java backend (backend-java) ------------------------------------------
# Spring Boot binds these standard names automatically.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/taskboard
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Origin allowed to call the API from a browser (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend (frontend/.env.local) -------------------------------------
# Base URL of whichever backend you are running.
#   Python (uvicorn): http://localhost:8000
#   .NET   (dotnet run): http://localhost:5088
VITE_API_BASE_URL=http://localhost:8000

# JWT_SECRET is introduced in Module 02, when authentication is added.
